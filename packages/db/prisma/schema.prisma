// Prisma Schema for FlowBridge
// Based on SPEC.md §8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELED
}

enum StepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum TaskStatus {
  OPEN
  DONE
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Branding for white-label embed
  branding  Json?    // { logoUrl, primaryColor, removeBranding }

  // Webhook secret for HMAC verification
  webhookSecret String? @unique

  members       Member[]
  forms         Form[]
  leads         Lead[]
  workflows     Workflow[]
  integrations  Integration[]
  tasks         Task[]
  activities    Activity[]
  intakeEvents  IntakeEvent[]
  workflowRuns  WorkflowRun[]
  apiKeys       ApiKey[]

  @@index([slug])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  password  String?  // Hashed password for credentials auth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Member[]
  apiKeys     ApiKey[]
  sessions    Session[]
  accounts    Account[]
}

model Member {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  role         Role     @default(AGENT)
  available    Boolean  @default(true)
  oooStart     DateTime?
  oooEnd       DateTime?
  skills       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Form {
  id            String   @id @default(cuid())
  workspaceId   String
  key           String   @unique
  name          String
  fields        Json     // Array of { name, label, type, required, options?, placeholder? }
  successMessage String?
  redirectUrl   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  intakeEvents  IntakeEvent[]

  @@index([workspaceId])
  @@index([key])
}

model IntakeEvent {
  id          String   @id @default(cuid())
  workspaceId String
  formId      String?
  source      String   // "form", "webhook", "csv", "manual"
  payload     Json     // Raw payload
  ip          String?
  userAgent   String?
  receivedAt  DateTime @default(now())
  leadId      String?  // Null if duplicate or failed to create lead

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form        Form?     @relation(fields: [formId], references: [id], onDelete: SetNull)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([workspaceId, source])
}

model Lead {
  id               String      @id @default(cuid())
  workspaceId      String
  name             String
  email            String?     @unique
  phone            String?
  source           String
  status           LeadStatus  @default(NEW)
  assigneeId       String?
  data             Json?       // Custom fields + UTM params
  firstContactedAt DateTime?
  lastActivityAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee         Member?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  activities       Activity[]
  tasks            Task[]
  workflowRuns     WorkflowRun[]
  intakeEvents     IntakeEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  type      String   // "status_change", "assignment", "note", "workflow_run", "email_sent", "task_created", etc.
  body      String?
  meta      Json?    // Additional context
  actorId   String?  // Member ID who performed the action
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Task {
  id             String      @id @default(cuid())
  workspaceId    String
  leadId         String?
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus  @default(OPEN)
  assigneeId     String?
  createdByRunId String?     // WorkflowRun that created this task
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee       Member?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueAt])
  @@index([leadId])
}

model Workflow {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  definition  Json     // Zod-validated WorkflowDefinition
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@index([workspaceId])
  @@index([workspaceId, enabled])
}

model WorkflowRun {
  id              String     @id @default(cuid())
  workflowId      String
  workflowVersion Int
  eventId         String     // IntakeEvent ID or manual trigger ID
  leadId          String?
  status          RunStatus  @default(QUEUED)
  startedAt       DateTime?
  finishedAt      DateTime?
  error           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workflow        Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  steps           RunStep[]

  @@unique([workflowId, eventId])
  @@index([workflowId, status])
  @@index([leadId])
  @@index([createdAt])
}

model RunStep {
  id          String      @id @default(cuid())
  runId       String
  stepKey     String      // Step ID from workflow definition
  type        String      // Step type: assign, create_task, update_field, send_email, send_telegram, http_request, delay
  status      StepStatus  @default(PENDING)
  attempts    Int         @default(0)
  input       Json?       // Rendered config input
  output      Json?       // Step output (secrets redacted)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model Integration {
  id        String   @id @default(cuid())
  workspaceId String
  type      String   // "email", "telegram", "slack", "webhook", "http"
  name      String
  configEnc String   // Encrypted config (AES-256-GCM)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
  @@unique([workspaceId, type, name])
}

model ApiKey {
  id        String   @id @default(cuid())
  workspaceId String
  userId    String
  name      String
  keyHash   String   // Hashed API key
  prefix    String   // First 8 chars for display
  scopes    String[] // e.g., ["read:leads", "write:workflows", "trigger:intake"]
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyHash])
}

// Auth.js models
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}