# ─────────────────────────────────────────────────────────────
# FlowBridge environment — copy into each package's env file and fill in:
#   cp .env.example .env                    # root (shell tooling / reference)
#   cp .env.example packages/db/.env        # Prisma CLI + db:seed read this
#   cp .env.example apps/web/.env.local     # next dev / next build read this
# (On Vercel, set these in Project → Settings → Environment Variables.)
# ─────────────────────────────────────────────────────────────

# Database (required) — pooled connection string for the app.
# If your provider puts a pooler in front of Postgres (Neon, Supabase, RDS Proxy,
# PgBouncer), append `pgbouncer=true`: the queue's `FOR UPDATE SKIP LOCKED` raw
# query uses a prepared statement that otherwise fails with
# `cached plan must not change result type` (0A000) on a transaction pooler.
DATABASE_URL="postgresql://user:password@host:5432/flowbridge?sslmode=require&pgbouncer=true"

# Auth (required) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-secret"
# NOTE: do NOT set NEXTAUTH_URL / AUTH_URL on Next 14.0.4 + next-auth v5 beta.
# Either one makes next-auth call `new NextRequest(...)` in `reqWithEnvURL`, which
# throws "next_dist_server_web_exports_next_request__WEBPACK_IMPORTED_MODULE_0__ is
# not a constructor" and 500s every auth route (nextauthjs/next-auth#9922). Auth.js
# v5 auto-detects the host from request headers, so the variable is unnecessary.
# For a self-hosted deployment behind a proxy, opt into trusting the forwarded host:
AUTH_TRUST_HOST="true"

# Encryption (required) — 32 bytes base64. Encrypts integration secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-base64-32-bytes"

# Queue (required) — bearer token for POST /api/internal/tick
CRON_SECRET="change-me-cron-secret"

# App URL (optional) — used in embed snippets and absolute lead links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ─────────────────────────────────────────
# Used to seed the workspace's `email` integration (see packages/db/src/seed.ts):
# with SMTP_HOST set the integration uses provider "smtp", otherwise it is
# seeded log-only (nothing leaves the box). SMTP_PROVIDER can force
# "smtp" | "resend" | "log"; resend reads RESEND_API_KEY. An integration
# configured in Settings (UI) always wins over these fallbacks and survives
# re-seeding.
# For local development, Mailpit listens on localhost:1025 (SMTP_SECURE=false).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"          # true for implicit TLS (port 465)
SMTP_USER=""
SMTP_PASSWORD=""             # quote if it contains `$`: SMTP_PASSWORD='a$b'
SMTP_FROM="FlowBridge <noreply@flowbridge.local>"
# RESEND_API_KEY=""          # only when SMTP_PROVIDER=resend

# ── Telegram (optional) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""

# ── Google OAuth (optional) ──────────────────────────────────
# The "Continue with Google" button renders only when BOTH values are set, so
# leaving them blank is safe: the visitor never sees a button that can only
# fail with Google's "OAuth client was not found (invalid_client)" error.
# Authorised redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google   (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Demo login (optional, OFF unless enabled) ────────────────
# Publishes a demo account on the sign-in page so an evaluator can explore the
# seeded workspace without signing up. This is opt-in: with DEMO_LOGIN unset the
# panel is hidden and `db:seed` does not create the account, so a forgotten or
# misspelled variable can never publish a working login. The seed creates the
# user and the login page advertises it from these same values — set them in
# *every* env file (see the header above) or the advertised password will not
# match the stored hash. Re-run `pnpm db:seed` after enabling.
DEMO_LOGIN="false"
DEMO_EMAIL="hello@g2gdigital.com"
DEMO_PASSWORD="demo123"
DEMO_NAME="G2G Demo"

