# ─────────────────────────────────────────────────────────────
# FlowBridge environment — copy to `.env` and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Database (required) — pooled connection string for the app.
# If your provider puts a pooler in front of Postgres (Neon, Supabase, RDS Proxy,
# PgBouncer), append `pgbouncer=true`: the queue's `FOR UPDATE SKIP LOCKED` raw
# query uses a prepared statement that otherwise fails with
# `cached plan must not change result type` (0A000) on a transaction pooler.
DATABASE_URL="postgresql://user:password@host:5432/flowbridge?sslmode=require&pgbouncer=true"

# Auth (required) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-secret"
# NOTE: do NOT set NEXTAUTH_URL / AUTH_URL on Next 14.0.4 + next-auth v5 beta.
# Either one makes next-auth call `new NextRequest(...)` in `reqWithEnvURL`, which
# throws "next_dist_server_web_exports_next_request__WEBPACK_IMPORTED_MODULE_0__ is
# not a constructor" and 500s every auth route (nextauthjs/next-auth#9922). Auth.js
# v5 auto-detects the host from request headers, so the variable is unnecessary.
# For a self-hosted deployment behind a proxy, opt into trusting the forwarded host:
AUTH_TRUST_HOST="true"

# Encryption (required) — 32 bytes base64. Encrypts integration secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-base64-32-bytes"

# Queue (required) — bearer token for POST /api/internal/tick
CRON_SECRET="change-me-cron-secret"

# App URL (optional) — used in embed snippets and absolute lead links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ─────────────────────────────────────────
# Fallback when an email integration uses provider = "smtp".
# For local development, Mailpit listens on localhost:1025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FlowBridge <noreply@flowbridge.local>"

# ── Telegram (optional) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""

# ── Google OAuth (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
